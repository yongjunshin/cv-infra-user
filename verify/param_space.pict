# verify/param_space.pict — carter "can this robot's software reach the goal?", warehouse scale
#
# One row = one case. Every axis is a flag of verify/sim.py (`--name=value`, text) and the
# harness owns what the values MEAN. cv-infra expands this with PICT (k=2), runs the harness
# once per row inside the stock Isaac 5.1.0 image, collects verify/out/ (including the two
# top-view pictures), and reads verify/oracle.py's flat JSON by TYPE. PICT reads a trailing
# `# …` on a value line as part of the value, so every comment sits on its own line.
#
# THE LAYOUT (map frame = world frame, metres; open warehouse floor — see verify/sim.py):
#
#   goals   G1 (-7, 11)  G2 (-3.5, 11)  G3 (0, 11)  G4 (3.5, 11)  G5 (7, 11)
#   row B   i (-6, 8)  j (-4, 8)  k (-2, 8)  l (0, 8)  m (2, 8)  n (4, 8)  o (6, 8)
#   row A   a (-7, 4)  b (-5, 4)  c (-3, 4)  d (-1, 4)  e (1, 4)  f (3, 4)  g (5, 4)  h (7, 4)
#   starts  S1 (-7, 1)   S2 (-3.5, 1)   S3 (0, 1)   S4 (3.5, 1)   S5 (7, 1)   facing +y
#
# Slots in a row are 2 m apart, so even two occupied neighbours leave a 1.3-1.4 m gap:
# a robot that finds gaps gets through, one that drives straight hits what is on its line.
#
# At k=2 PICT (pinned build) makes 28 rows: all 25 start x goal pairs, 6-14 slots filled.
#
# CASE IDENTITY is a hash of a row's own assignment: a baseline follows a case across
# commits only as long as its values are untouched.

start:   S1, S2, S3, S4, S5
goal:    G1, G2, G3, G4, G5

# Each slot is empty or holds one stock warehouse prop (static collider, axis-aligned):
#   cardbox = SM_CardBoxA_01        0.70 x 0.50 x 0.50 m
#   barrel  = SM_BarelPlastic_A_01  0.60 x 0.71 x 0.90 m
slot_a:  empty, cardbox, barrel
slot_b:  empty, cardbox, barrel
slot_c:  empty, cardbox, barrel
slot_d:  empty, cardbox, barrel
slot_e:  empty, cardbox, barrel
slot_f:  empty, cardbox, barrel
slot_g:  empty, cardbox, barrel
slot_h:  empty, cardbox, barrel
slot_i:  empty, cardbox, barrel
slot_j:  empty, cardbox, barrel
slot_k:  empty, cardbox, barrel
slot_l:  empty, cardbox, barrel
slot_m:  empty, cardbox, barrel
slot_n:  empty, cardbox, barrel
slot_o:  empty, cardbox, barrel
